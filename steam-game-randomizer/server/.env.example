# STEAM WEB API KEY - Get yours at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=YOUR_STEAM_API_KEY_HERE

# Session secret - Generate with: openssl rand -hex 32
SESSION_SECRET=random-secret-string-change-this-in-production

# BASE_URL - Your deployed URL (same as where your domain points)
# Leave as-is for local development
BASE_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Server port
PORT=3000